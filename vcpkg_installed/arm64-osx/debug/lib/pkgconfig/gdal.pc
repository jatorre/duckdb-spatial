prefix=${pcfiledir}/../..
CONFIG_VERSION=3.8.5
CONFIG_INST_PREFIX=${prefix}
CONFIG_INST_LIBS="-L${prefix}/lib" -lgdal "-L${prefix}/lib" -lexpat -lgeos_c -lgeos -lcurl-d "-l-framework SystemConfiguration" "-l-framework Security" "-l-framework CoreFoundation" "-l-framework CoreServices" -lssl -lcrypto -lproj -ldl -lsqlite3 -ltiffd -llzma -ljpeg -lz -lm -lc++
CONFIG_INST_CFLAGS="-I${prefix}/../include"
CONFIG_INST_DATA=${prefix}/../share/gdal
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${exec_prefix}/include
datadir=${CONFIG_INST_DATA}

Name: libgdal
Description: Geospatial Data Abstraction Library
Version: ${CONFIG_VERSION}

Libs: ${CONFIG_INST_LIBS}
Cflags: ${CONFIG_INST_CFLAGS}
